# ==========================================
#     NETWORK & WEB SERVER CONFIG
# ==========================================
# Address and port to bind the HTTP server to
BIND_ADDRESS=0.0.0.0:3000

# CORS settings. Can be "any", "all", or comma-separated origins: "https://app.example.com,http://localhost:5173"
CORS_ALLOWED_ORIGINS=any

# ==========================================
#     LOGGING CONFIG
# ==========================================
# Global logging level and pointwise overrides.
# Levels: trace, debug, info, warn, error
RUST_LOG=info,necko3_core=debug,tower_http=debug

# Format: compact | json | full
LOG_FORMAT=compact

# ==========================================
#     DATABASE CONFIG
# ==========================================
# Database type: postgres | mock
DATABASE_TYPE=postgres

# --- Docker Initialization Variables ---
# These variables are primarily used by Docker Compose to bootstrap
# the PostgreSQL database container with correct credentials on its first run.
DATABASE_USER=necko_user
DATABASE_PASSWORD=password
DATABASE_DB=necko3

# --- Application Connection Variables ---
# Connection pool limit
DATABASE_MAX_CONNECTIONS=20

# Full connection string used by the application
# Format: postgres://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgres://necko_user:password@127.0.0.1:5432/necko3

# ==========================================
#     RATE LIMITING (tower-governor)
# ==========================================
# Public checkout endpoints (IP-based limit, e.g. for checkout pages)
PUBLIC_RL_REPLENISH_INTERVAL_MS=1000
PUBLIC_RL_BURST_SIZE=10

# Strategy for public rate limiting: peer | smart
# - Use "peer" (default) for local development or if your app is connected directly to the internet.
# - Use "smart" ONLY if your app runs behind a trusted reverse proxy (Nginx, Cloudflare, Traefik, Caddy).
#   WARNING: Setting "smart" without a reverse proxy allows attackers to bypass limits by forging headers.
PUBLIC_RATE_LIMIT_STRATEGY=peer

# Private API endpoints (Key-based limit, e.g. for merchant backend actions)
PRIVATE_RL_REPLENISH_INTERVAL_MS=200
PRIVATE_RL_BURST_SIZE=50

# ==========================================
#     CORE ENGINE CONFIG (necko3-core)
# ==========================================
# Toggle background janitor service
# The Janitor service marks all invoices whose time has passed as EXPIRED once per tick
ENABLE_JANITOR=true

# Toggle background webhook dispatcher service.
#    The WEBHOOK DISPATCHER service handles webhooks with retry logic and status changes.
#    If webhooks are NEVER used, this service can be disabled.
# Disabling this service will give you:
#  1. 5 bytes of RAM saved,
#  2. The database will not be updated by index every tick.
#  3. Webhooks will not be processed or changed at all.
#  4. If webhooks are sent, they accumulate in a queue untouched in the database.
ENABLE_WEBHOOK_DISPATCHER=true

# Interval in seconds for the database invoice expiring task (janitor)
JANITOR_INTERVAL_SECS=30

# Interval in seconds for the webhook dispatcher polling task
WEBHOOK_DISPATCH_INTERVAL_SECS=5

# Maximum number of pending webhooks fetched from database in a single query
WEBHOOK_SELECTION_LIMIT=50

# Concurrency limit for background webhook requests sending in parallel
WEBHOOK_CONCURRENCY_LIMIT=100